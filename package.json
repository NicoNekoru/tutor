{
  "name": "tutor-rlm",
  "version": "0.1.0",
  "description": "RLM-based tutoring application with persistent pedagogical memory",
  "main": "dist/index.js",
  "bin": {
    "tutor": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "tutor",
    "rlm",
    "education",
    "tui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.10.2",
    "blessed": "^0.1.81",
    "commander": "^11.1.0",
    "front-matter": "^4.0.2",
    "marked": "^11.1.1",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
